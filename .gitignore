# Dependencies
node_modules/
__pycache__/

# Logs — the server and cloudflared write these into the project root
*.log
*.err.log
*.out.log
server*.log
cloudflared-*.log
npm-debug.log*

# Uploaded files
# Binaries don't belong in git, and these are real documents uploaded through
# the job-request flow — they may contain customer information.
# Backed up separately by scripts/backup-data.mjs.
data/uploads/

# Data backups (the rolling snapshots, not the live file)
data/backups/

# Transient atomic-write file (saveBackend writes here, then renames over backend.json)
data/backend.json.tmp

# Identity (Phase 12a): password hashes, sessions, sign-on links, the break-glass account,
# the generated break-glass password, and the append-only audit trail. Never in git.
data/auth.json
data/auth.json.tmp
data/break-glass-password.txt
data/audit.log
# Phase 25 A.3b: the key behind employees.licenceHash (driver's-licence check-in). Never in git.
data/id-hash-secret.txt

# Environment and secrets
.env*
*.pem

# Editors
.vscode/
.idea/
*.swp

# Claude Code — machine-local state (lock files, per-machine permissions).
# launch.json is shared project config, so it stays tracked.
.claude/*
!.claude/launch.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# NOTE: data/backend.json IS tracked deliberately.
# It is currently the only copy of all ~104 shared collections, so version
# history is worth more than a clean diff. Revisit at roadmap Phase 14,
# when the data moves into PostgreSQL. data/demo-seed.json is tracked too.

# Phase 21 field command receipts (server-owned, per data folder)
data/command-receipts.json

# Phase 24: the training copy's data folder (sample data rebuilt nightly by scripts/reset-training.mjs,
# plus its own auth.json, logs and uploads). Never in git.
data-training/

# Phase 24: the printed user guide is generated by scripts/build-user-guide.mjs (screenshots, ~35 MB).
docs/user-guide/

# Wrangler's local cache next to the Worker (live hosting, 2026-10-01)
.wrangler/
